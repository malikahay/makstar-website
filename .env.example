# Next.js: where the Go API lives (server-side fetches + /api and /admin proxy)
API_URL=http://localhost:8080

# Go API (read by docker-compose)
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-chars
ADMIN_EMAIL=admin@makstar.uz
ADMIN_PASSWORD=change-me
COOKIE_SECURE=false

# Telegram notifications about new orders and contact form messages (optional; off when empty).
# Bot token from @BotFather; chat id of the group the bot was added to (negative number, e.g. -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Public site address, used for "open in admin" links in notifications, e.g. https://makstar.uz
SITE_URL=
